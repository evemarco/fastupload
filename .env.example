# Server Configuration
# Host to listen on (use 0.0.0.0 to listen on all interfaces, including VPN)
# Examples:
#   - 0.0.0.0 (default, listen on all interfaces - localhost, local network, VPN)
#   - 127.0.0.1 (localhost only)
#   - 10.8.0.1 (specific VPN IP)
#   - 192.168.1.100 (specific local network IP)
HOST=0.0.0.0

PORT=3000

# Upload Configuration
MAX_FILE_SIZE_GB=50

# Upload Directory (absolute or relative path)
UPLOAD_DIR=./uploads

# CORS Settings
CORS_ORIGIN=*

# Chunk Size (in bytes, default 50MB)
# Recommended: 50MB for standard broadband
# Use smaller sizes (10-25MB) for slow/unstable networks
# Use larger sizes (100-200MB) for fast/stable networks
CHUNK_SIZE_MB=50

# Max Parallel Uploads (default: 4)
# Number of files uploaded simultaneously when a batch (folder) is uploaded.
# Remaining files wait in a client-side queue.
MAX_PARALLEL_UPLOADS=4

# Add Timestamp to Filename (default: true)
# When true: file-1706159234567.ext (prevents overwrites)
# When false: file.ext (may overwrite if same name)
# Set to false to keep original filenames exactly
# Recommended: true for production, false for personal use
ADD_TIMESTAMP_TO_FILENAME=true

# Access Key (optional)
# Leave empty to disable authentication (public access)
# Set a key to require authentication for web access
# Example: ACCESS_KEY=my-secret-key-123
ACCESS_KEY=
