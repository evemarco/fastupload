# Server Configuration
PORT=3000

# Upload Configuration
MAX_FILE_SIZE_GB=50

# Upload Directory (absolute or relative path)
UPLOAD_DIR=./uploads

# CORS Settings
CORS_ORIGIN=*

# Chunk Size (in bytes, default 50MB)
# Recommended: 50MB for standard broadband
# Use smaller sizes (10-25MB) for slow/unstable networks
# Use larger sizes (100-200MB) for fast/stable networks
CHUNK_SIZE_MB=50
